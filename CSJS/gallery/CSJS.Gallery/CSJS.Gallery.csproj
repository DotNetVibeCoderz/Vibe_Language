<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CSJS Gallery host.

    Serves the gallery page and every protocol the API playground talks to: REST, gRPC-Web,
    SignalR, Socket.IO, raw WebSocket, and Server-Sent Events. The browser side is C# too — it
    lives in CSJS.Gallery.Client and is transpiled into wwwroot/js by CSJS.Build on each build.
    Gravicode Studios — led by Kang Fadhil.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CSJS.Gallery</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.84.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\gallery.proto" GrpcServices="Server" />
  </ItemGroup>

  <!-- The client builds first, so wwwroot/js is current when the server starts. -->
  <ItemGroup>
    <ProjectReference Include="..\CSJS.Gallery.Client\CSJS.Gallery.Client.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

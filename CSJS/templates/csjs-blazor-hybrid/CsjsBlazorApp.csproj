<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    CsjsClient/ holds the browser-side C#. It has its own project, which CSJS.Build transpiles
    into wwwroot/js; it must not be compiled into this server assembly as well.
  -->
  <ItemGroup>
    <Compile Remove="CsjsClient/**" />
    <Content Remove="CsjsClient/**" />
    <None Remove="CsjsClient/**" />
    <EmbeddedResource Remove="CsjsClient/**" />
  </ItemGroup>

  <!--
    Referencing the client project makes it build first, so wwwroot/js is current when the
    server starts. Its assembly is never loaded — the reference is for ordering only.
  -->
  <ItemGroup>
    <ProjectReference Include="CsjsClient/CsjsBlazorApp.Client.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gravicode Studios",
  "classifications": [
    "CSJS",
    "Library",
    "npm"
  ],
  "identity": "Csjs.Library",
  "name": "CSJS JavaScript Library",
  "shortName": "csjs-lib",
  "description": "A library written in C# and published to npm: `dotnet build` emits tree-shakeable ES modules with TypeScript declarations into dist/, and package.json points npm at them.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CsjsLib",
  "preferNameDirectory": true,
  "symbols": {
    "packageName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerCase",
      "replaces": "csjs-lib-package",
      "description": "npm package name, derived from the project name."
    }
  },
  "forms": {
    "lowerCase": { "identifier": "lowerCase" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/dist/**",
        "**/node_modules/**",
        "**/*.user",
        "**/.vs/**"
      ]
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}

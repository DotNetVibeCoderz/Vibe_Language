<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A JavaScript library written in C#.

    `dotnet build` transpiles every public type into dist/ as an ES module with a .d.ts beside it,
    which is what package.json publishes. `npm test` runs test.mjs against the built output.
    Gravicode Studios — led by Kang Fadhil.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CsjsLib</RootNamespace>
    <CsjsOutputPath>dist/</CsjsOutputPath>
    <!-- A library has nothing to serve; `dotnet run` is not meaningful here. -->
    <CsjsWebRoot>$(MSBuildProjectDirectory)/dist/</CsjsWebRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSJS.Build" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="package.json;test.mjs" />
  </ItemGroup>

</Project>

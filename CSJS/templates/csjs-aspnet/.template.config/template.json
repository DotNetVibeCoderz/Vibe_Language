{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gravicode Studios",
  "classifications": [
    "CSJS",
    "Web",
    "ASP.NET"
  ],
  "identity": "Csjs.AspNet",
  "name": "CSJS ASP.NET + JS",
  "shortName": "csjs-aspnet",
  "description": "An ASP.NET Core app whose browser code is written in C#. The client project transpiles C# to JavaScript on every build through CSJS.Build — no global tool needed.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CsjsAspNetApp",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/dist/**",
        "**/node_modules/**",
        "**/*.user",
        "**/*.filelist",
        "**/*.lock.json",
        "**/.vs/**",
        "**/wwwroot/js/**"
      ]
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}

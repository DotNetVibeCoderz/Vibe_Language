<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComeInteropSupport>true</BuiltInComeInteropSupport>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Set here rather than in the manifest, which WinForms warns about. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The Blazor UI is hosted in a BlazorWebView, which ships in the WindowsForms package —
      hence the windows-specific target framework. Avalonia owns configuration and theming.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>CSJSGen</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Semantic Kernel connectors are still evolving; the experimental diagnostics are expected. -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0070;CS1591</NoWarn>
    <!--
      MSB3277: the WebView2 package carries a WPF assembly that binds an older WindowsBase.
      Nothing here uses WPF, so the unification the build already performs is correct.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />

    <!-- Blazor hosted inside the Avalonia shell: the editor and chat UI are Razor components. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.90" />

    <PackageReference Include="Microsoft.SemanticKernel" Version="1.78.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.78.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.AzureOpenAI" Version="1.78.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.78.0-alpha" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.78.0-alpha" />

    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- A real code editor: C# highlighting, line numbers, find/replace, formatting. -->
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The CLI, for its BuildRunner and csjs.json handling. Referencing it rather than
      reimplementing means the browser preview builds a project exactly as `cs2js build` does,
      assets included — one authority, so the two cannot drift apart.
    -->
    <ProjectReference Include="..\CSJS.Cli\CSJS.Cli.csproj" />
    <ProjectReference Include="..\CSJS.Core\CSJS.Core.csproj" />
    <!-- Monaco's IntelliSense: the engine behind `cs2js lsp`, called in-process. -->
    <ProjectReference Include="..\CSJS.LanguageService\CSJS.LanguageService.csproj" />
    <ProjectReference Include="..\CSJS.Interop\CSJS.Interop.csproj" />
    <ProjectReference Include="..\CSJS.Testing\CSJS.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    BlazorWebView loads its host page from the file system at runtime, but the Razor SDK
    routes wwwroot into the static web assets pipeline instead of the output folder. Copying
    it explicitly is what makes HostPage resolve.
  -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

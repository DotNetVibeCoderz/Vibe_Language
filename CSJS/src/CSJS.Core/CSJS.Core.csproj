<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CSJS.Core</RootNamespace>
    <AssemblyName>CSJS.Core</AssemblyName>
    <PackageId>CSJS.Core</PackageId>
    <Description>The CSJS transpiler engine: compiles a large subset of C# to modern, tree-shakeable ESNext JavaScript with TypeScript declarations and source maps.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSJS.Interop\CSJS.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime\csjs-runtime.js" LogicalName="CSJS.Core.Runtime.csjs-runtime.js" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The same CLI packaged under the short command name.

    Two packages exist because a tool package declares exactly one command name, and the two
    documented invocations need different shims: `dotnet cs2js` requires a `dotnet-cs2js`
    executable on PATH, while `cs2js` on its own requires one called `cs2js`.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CSJS.Cli</RootNamespace>
    <AssemblyName>cs2js</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cs2js</ToolCommandName>
    <PackageId>CSJS.Cli.Standalone</PackageId>
    <Description>The CSJS transpiler CLI under the short `cs2js` command. Install CSJS.Cli instead if you prefer `dotnet cs2js`.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSJS.Core\CSJS.Core.csproj" />
    <ProjectReference Include="..\CSJS.Interop\CSJS.Interop.csproj" />
    <ProjectReference Include="..\CSJS.Testing\CSJS.Testing.csproj" />
    <ProjectReference Include="..\CSJS.Web\CSJS.Web.csproj" />
    <!-- `cs2js lsp`: the language server shares its engine with CSJSGen. -->
    <ProjectReference Include="..\CSJS.LanguageService\CSJS.LanguageService.csproj" />
  </ItemGroup>

  <!-- One implementation, two packages: the sources are shared rather than duplicated. -->
  <ItemGroup>
    <Compile Include="..\CSJS.Cli\*.cs" />
  </ItemGroup>

</Project>
